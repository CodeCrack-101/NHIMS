# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String
MONGO_DATABASE=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/enterprise_crm?retryWrites=true&w=majority

# Resend Email Configuration
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# Cryptographic Secrets (Generate 64-byte hex strings via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=replace_with_64_char_hex_secret
OTP_HMAC_SECRET=replace_with_64_char_hex_secret
CSRF_SECRET=replace_with_64_char_hex_secret

# Initial Seed User (Optional - for utils/seedAdmin.js)
ADMIN_SEED_EMAIL=admin@companycrm.com
ADMIN_SEED_PASSWORD=ChangeMeImmediately@2026!
